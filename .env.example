# ============================================================================
# IP HOUSE - SECURE CONFIGURATION TEMPLATE
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local (DO NOT commit .env.local)
# 2. Replace all <...> placeholders with actual values
# 3. Use strong, randomly-generated values for secrets
# 4. Rotate secrets monthly in production
# ============================================================================

# ── Environment ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── Database Configuration (use separate credentials for dev/staging/prod) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=<secure-database-password>
DB_NAME=iphouse_dev
DB_MAX_CONNECTIONS=10

# ── Encryption Keys (CRITICAL: Generate with crypto.randomBytes()) ──────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<32-character-hex-string>
API_CRED_KEY=<32-character-hex-string>
API_CRED_IV=<16-character-hex-string>
NEXTAUTH_SECRET=<32-character-hex-string>

# ── Session Configuration ──────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_SECONDS=1800
NEXTAUTH_URL=http://localhost:8080

# ── SSL/TLS Configuration ──────────────────────────────────────────────────
# Development only: Allow self-signed certificates
# ALLOW_INSECURE_SSL_DEV_ONLY=false
#
# Production: Configure CA bundle path
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-bundle.crt

# ── CORS - Whitelist Only Your Domains ──────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Markscan API Integration ───────────────────────────────────────────────
MARKSCAN_API_BASE=https://api.markscan.co.in
MARKSCAN_API_KEY=<obtain-from-markscan-admin>

# ── Email Configuration (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=<secure-smtp-password>
SMTP_FROM="IP House <noreply@example.com>"

# ── Maintenance Mode ───────────────────────────────────────────────────────
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System maintenance in progress. Please try again later.

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
# ✓ .env.local is in .gitignore and NOT tracked
# ✓ All secrets are randomly generated (min 32 characters)
# ✓ Database credentials use strong passwords (min 16 chars)
# ✓ Separate credentials for dev/staging/production
# ✓ SSL/TLS verification enabled in production
# ✓ CORS origins explicitly whitelisted (no wildcards)
# ✓ Secrets rotated monthly
# ✓ Sensitive data NOT logged to console
# ✓ MFA enabled for admin accounts
# ✓ API keys stored server-side, not in JWT
# ============================================================================
